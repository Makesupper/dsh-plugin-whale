{
  "name": "dsh-plugin-whale",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for 3D DeepSeek Whale Girl companion, real-time LLM response Web Speech synthesis, and wooden-fish rhythmic accompaniment.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepare": "npm run build",
    "test": "node --test tests/whale.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "whale",
    "deepseek-whale",
    "3d-companion",
    "tts",
    "muyu"
  ],
  "author": "Makesupper",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
